rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isPostOwner(postId) {
      return get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid;
    }
    function isConversationMember(conversationId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId && request.resource.data.uid == userId;
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.title is string && request.resource.data.course is string && request.resource.data.category is string && request.resource.data.driveUrl is string;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /opinions/{opinionId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.course is string && request.resource.data.code is string && request.resource.data.college is string && request.resource.data.text is string && request.resource.data.text.size() <= 1000 && request.resource.data.ratingEase is number && request.resource.data.ratingEase >= 1 && request.resource.data.ratingEase <= 5 && request.resource.data.ratingExams is number && request.resource.data.ratingExams >= 1 && request.resource.data.ratingExams <= 5 && request.resource.data.ratingWorkload is number && request.resource.data.ratingWorkload >= 1 && request.resource.data.ratingWorkload <= 5 && request.resource.data.ratingContent is number && request.resource.data.ratingContent >= 1 && request.resource.data.ratingContent <= 5;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /collegePosts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.college is string && request.resource.data.type is string && request.resource.data.heading is string && request.resource.data.text is string;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /ratings/{ratingId} {
      allow read: if signedIn();
      allow create: if signedIn() && ratingId == request.resource.data.postId + '_' + request.auth.uid && request.resource.data.keys().hasOnly(['postId','uid','value','createdAt','updatedAt']) && request.resource.data.postId is string && request.resource.data.uid == request.auth.uid && request.resource.data.value in [-1,1] && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId)) && !isPostOwner(request.resource.data.postId);
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['postId','uid','value','createdAt','updatedAt']) && request.resource.data.postId == resource.data.postId && request.resource.data.uid == resource.data.uid && request.resource.data.value in [-1,1];
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /reports/{reportId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && reportId == request.resource.data.postId + '_' + request.auth.uid && request.resource.data.keys().hasOnly(['postId','uid','reason','details','status','createdAt']) && request.resource.data.postId is string && request.resource.data.uid == request.auth.uid && request.resource.data.reason in ['رابط لا يعمل','محتوى مكرر','معلومات غير صحيحة','محتوى غير مناسب'] && request.resource.data.details is string && request.resource.data.details.size() <= 500 && request.resource.data.status == 'جديد' && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId));
      allow update, delete: if false;
    }

    match /favorites/{favoriteId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && favoriteId == request.resource.data.postId + '_' + request.auth.uid && request.resource.data.keys().hasOnly(['postId','uid','createdAt']) && request.resource.data.postId is string && request.resource.data.uid == request.auth.uid && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId));
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid','userName','userPhoto','text','imageUrl','background','createdAt','expiresAt']) && request.resource.data.uid == request.auth.uid && request.resource.data.userName is string && request.resource.data.text is string && request.resource.data.text.size() <= 500 && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 2000 && (request.resource.data.text.size() > 0 || request.resource.data.imageUrl.size() > 0) && request.resource.data.background in ['violet','blue','emerald','sunset'];
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['members','memberNames','lastMessage','createdAt','updatedAt']) && request.resource.data.members is list && request.resource.data.members.size() == 2 && request.auth.uid in request.resource.data.members && request.resource.data.memberNames is list && request.resource.data.memberNames.size() == 2 && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 1000;
      allow update: if signedIn() && request.auth.uid in resource.data.members && request.resource.data.members == resource.data.members && request.resource.data.memberNames == resource.data.memberNames && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId) && request.resource.data.keys().hasOnly(['uid','text','createdAt']) && request.resource.data.uid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }
  }
}
