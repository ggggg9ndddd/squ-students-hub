rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(field) { return signedIn() && resource.data[field] == request.auth.uid; }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /resources/{resourceId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.course is string
        && request.resource.data.college is string
        && request.resource.data.driveUrl is string;
      allow update, delete: if owns('uid');
    }

    match /communityPosts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.college is string
        && request.resource.data.content is string;
      allow update, delete: if owns('uid');
    }
  }
}
