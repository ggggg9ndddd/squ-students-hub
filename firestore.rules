rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
match /users/{userId} { allow read: if request.auth != null; allow create, update: if request.auth != null && request.auth.uid == userId; allow delete: if false; }
match /posts/{postId} { allow read: if request.auth != null; allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.title is string && request.resource.data.course is string && request.resource.data.category is string && request.resource.data.driveUrl is string; allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid; }
match /opinions/{opinionId} { allow read: if request.auth != null; allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.course is string && request.resource.data.code is string && request.resource.data.college is string && request.resource.data.text is string && request.resource.data.text.size() <= 1000 && request.resource.data.ratingEase is number && request.resource.data.ratingEase >= 1 && request.resource.data.ratingEase <= 5 && request.resource.data.ratingExams is number && request.resource.data.ratingExams >= 1 && request.resource.data.ratingExams <= 5 && request.resource.data.ratingWorkload is number && request.resource.data.ratingWorkload >= 1 && request.resource.data.ratingWorkload <= 5 && request.resource.data.ratingContent is number && request.resource.data.ratingContent >= 1 && request.resource.data.ratingContent <= 5; allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid; }
match /collegePosts/{postId} { allow read: if request.auth != null; allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.college is string && request.resource.data.type is string && request.resource.data.heading is string && request.resource.data.text is string; allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid; }
match /ratings/{ratingId} { allow read: if request.auth != null; allow create: if request.auth != null && ratingId == request.resource.data.postId + '_' + request.auth.uid && request.resource.data.keys().hasOnly(['postId','uid','value','createdAt','updatedAt']) && request.resource.data.postId is string && request.resource.data.uid == request.auth.uid && request.resource.data.value in [-1,1] && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId)) && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.uid != request.auth.uid; allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['postId','uid','value','createdAt','updatedAt']) && request.resource.data.postId == resource.data.postId && request.resource.data.uid == resource.data.uid && request.resource.data.value in [-1,1]; allow delete: if request.auth != null && resource.data.uid == request.auth.uid; }
match /reports/{reportId} { allow read: if request.auth != null && resource.data.uid == request.auth.uid; allow create: if request.auth != null && reportId == request.resource.data.postId + '_' + request.auth.uid && request.resource.data.keys().hasOnly(['postId','uid','reason','details','status','createdAt']) && request.resource.data.postId is string && request.resource.data.uid == request.auth.uid && request.resource.data.reason in ['رابط لا يعمل','محتوى مكرر','معلومات غير صحيحة','محتوى غير مناسب'] && request.resource.data.details is string && request.resource.data.details.size() <= 500 && request.resource.data.status == 'جديد' && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId)); allow update, delete: if false; }
match /favorites/{favoriteId} { allow read: if request.auth != null && resource.data.uid == request.auth.uid; allow create: if request.auth != null && favoriteId == request.resource.data.postId + '_' + request.auth.uid && request.resource.data.keys().hasOnly(['postId','uid','createdAt']) && request.resource.data.postId is string && request.resource.data.uid == request.auth.uid && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId)); allow update: if false; allow delete: if request.auth != null && resource.data.uid == request.auth.uid; }
}}
